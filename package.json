{
  "name": "toolpath-template",
  "version": "0.0.0",
  "private": true,
  "description": "Toolpath DFM reference application",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs && pnpm install --frozen-lockfile",
    "dev": "pnpm --filter @toolpath/dfm dev",
    "build": "turbo run build --output-logs=errors-only",
    "check-types": "turbo run check-types --output-logs=errors-only",
    "test": "pnpm test:setup && turbo run test --output-logs=errors-only",
    "test:setup": "node --test scripts/setup-local.test.mjs",
    "test:e2e": "pnpm --filter @toolpath/dfm test:e2e",
    "check": "pnpm build && pnpm check-types && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "turbo": "2.10.10"
  }
}
