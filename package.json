{
  "name": "toolpath-template",
  "version": "0.0.0",
  "private": true,
  "description": "Toolpath reference applications and the packages they share",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.18.0"
  },
  "packageManager": "pnpm@10.6.5",
  "scripts": {
    "setup:local": "node scripts/setup-local.mjs && pnpm install --frozen-lockfile && pnpm exec husky",
    "prepare": "husky",
    "dev": "pnpm --filter @toolpath/dfm dev",
    "dev:catalog": "pnpm --filter @toolpath/catalog dev",
    "build": "turbo run build --output-logs=errors-only",
    "check-types": "turbo run check-types --output-logs=errors-only",
    "test": "pnpm test:setup && turbo run test --output-logs=errors-only",
    "test:setup": "node --test scripts/setup-local.test.mjs scripts/check-style.test.mjs",
    "test:e2e": "pnpm test:e2e:dfm && pnpm test:e2e:catalog",
    "test:e2e:dfm": "pnpm --filter @toolpath/dfm test:e2e",
    "test:e2e:catalog": "pnpm --filter @toolpath/catalog test:e2e",
    "check-style": "node scripts/check-style.mjs",
    "lint": "eslint .",
    "check": "pnpm check-style && pnpm lint && pnpm build && pnpm check-types && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "pnpm": {
    "overrides": {
      "@toolpath/tool-drawing": "link:../toolpath-ui-packages/packages/tool-drawing",
      "@toolpath/tool-scraper": "link:../toolpath-ui-packages/packages/tool-scraper"
    }
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "eslint": "10.9.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.6.2",
    "turbo": "2.10.10",
    "typescript-eslint": "8.68.0"
  }
}
