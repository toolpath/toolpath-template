{
  "name": "@toolpath/part-client",
  "version": "0.0.0",
  "private": true,
  "description": "The browser half of the part API: typed fetches, error messages, and the session and analysis-event hooks",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.2.0"
  },
  "dependencies": {
    "@toolpath/part-contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "^19.0.0",
    "react": "19.2.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
