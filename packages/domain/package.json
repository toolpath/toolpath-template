{
  "name": "@toolpath/domain",
  "version": "0.0.0",
  "private": true,
  "description": "Pure domain helpers shared by every Toolpath application in this workspace",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./units": {
      "types": "./dist/units.d.ts",
      "import": "./dist/units.js"
    },
    "./class-names": {
      "types": "./dist/class-names.d.ts",
      "import": "./dist/class-names.js"
    },
    "./list-keys": {
      "types": "./dist/list-keys.d.ts",
      "import": "./dist/list-keys.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "jsdom": "30.0.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
