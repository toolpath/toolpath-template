{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.AsyncIterable", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "client/*": ["app/client/*"],
      "components/*": ["app/components/*"],
      "routes/*": ["app/routes/*"],
      "shared/*": ["app/shared/*"],
      "server/*": ["server/*"],
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"],
      "react-dom": ["./node_modules/@types/react-dom"],
      "react-dom/*": ["./node_modules/@types/react-dom/*"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "types": ["@testing-library/jest-dom", "node", "vite/client"]
  },
  "include": ["app", "server", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
