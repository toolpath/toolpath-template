{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.AsyncIterable", "DOM.Iterable", "ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "components/*": ["app/components/*"],
      "client/*": ["app/client/*"],
      "routes/*": ["app/routes/*"],
      "shared/*": ["app/shared/*"]
    },
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "types": ["node", "vite/client"]
  },
  "include": [
    "app",
    "server",
    "vite.config.ts",
    "vitest.config.ts",
    "test.matchers.ts",
    "playwright.config.ts"
  ]
}
